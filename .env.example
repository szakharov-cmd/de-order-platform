# Copy to .env before running the project.
# Replace example credentials and generate valid Fernet, JWT and Kafka keys.
# Keep POSTGRES_DB=shop and DEBEZIUM_USER=debezium: SQL/config use these names.
# AIRFLOW_DB_PASSWORD must be URL-safe in the current connection URI.

POSTGRES_DB=shop
POSTGRES_USER=user_name
POSTGRES_PASSWORD=some_pass

DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium_role_pass

RUSTFS_ACCESS_KEY=rustfs_akey
RUSTFS_SECRET_KEY=rustfs_skey

WAREHOUSE_USER=warehouse_user_name
WAREHOUSE_PASS=warehouse_pass

AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=airflow_db_pass
AIRFLOW_FERNET_KEY=airflow_fernet_key
AIRFLOW_JWT_SECRET=airflow_jwt_key

KAFKA_CLUSTER_ID=cluster_id
